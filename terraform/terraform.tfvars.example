# Copy to terraform.tfvars (gitignored) or pass with -var-file.

domain_name = "jon-allyn.com"
alert_email = "REPLACE-ME@example.com" # receives budget and alarm notifications

# First apply, before your registrar points at Route53: set this to false so ACM
# validation does not block. Flip to true once `terraform output nameservers`
# has been applied at the registrar and delegation has propagated.
enable_custom_domain = true

aws_region      = "us-east-1"
github_owner    = "jallyn18"
site_repo       = "personal-site-gatsby"
automation_repo = "personal-site-automation"

monthly_budget_usd        = 10
uptime_check_rate_minutes = 5

# The cost figures on the site cover the whole account by default. If this
# account holds anything besides the site, scope them -- the number is published
# publicly, and everything in this stack is already tagged Project.
#
# Activate the tag first under Billing -> Cost allocation tags. It takes up to
# 24 hours to appear in Cost Explorer afterwards.
#
# cost_filter_tag = {
#   key   = "Project"
#   value = "personal-site"
# }
