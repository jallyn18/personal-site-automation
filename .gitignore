# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraform.lock.hcl.bak

# Variable files and backend config hold account-specific values, not secrets,
# but there is no reason to publish them.
*.tfvars
*.tfvars.json
!*.tfvars.example
# ci.tfvars holds no secrets -- see the comment at the top of it.
!terraform/ci.tfvars
backend.hcl

# Lambda zips are built from source on every plan.
terraform/build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp
